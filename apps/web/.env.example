# Backend API base URL (e.g. http://localhost:8000)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# OPTIONAL: pre-bake a JWT for development. In production, the login flow
# stores the token in localStorage instead. Leave blank to require sign-in.
# NEXT_PUBLIC_API_TOKEN=

# Hardcoded property scope for the demo (single-tenant frontend).
# Use the seed property UUID:
NEXT_PUBLIC_PROPERTY_ID=00000000-0000-0000-0000-000000000003
