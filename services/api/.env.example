# Waxwing API — environment variable reference
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env with real secrets to source control.
# Subbu manages real values in the secrets management system.

# ---------------------------------------------------------------------------
# Database
# Accepts postgresql:// or postgresql+asyncpg:// (env.py normalizes the prefix)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/waxwing

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=local
# 32+ random bytes — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-secret-key

# ---------------------------------------------------------------------------
# S3-compatible object storage (Phase 3 — document uploads and embeddings)
# For local dev: use MinIO (docker run -p 9000:9000 minio/minio)
# ---------------------------------------------------------------------------
S3_BUCKET=waxwing-documents
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Email delivery (Phase 4 — follow-up emails and tour confirmations)
# Provider selected by Subbu in Phase 0. Replace values when provider is chosen.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=SG.replace-with-api-key
EMAIL_FROM_ADDRESS=noreply@sunsetapts.example
EMAIL_FROM_NAME=Sunset Apartments

# ---------------------------------------------------------------------------
# Google Calendar (Phase 4 — tour availability and booking)
# OAuth app registered by Subbu. Redirect URI must match exactly.
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/v1/calendar/oauth/callback

# ---------------------------------------------------------------------------
# Embedding model (Phase 3 — RAG chunking and retrieval)
# EMBEDDING_MODEL controls which model is used; update EMBEDDING_DIMENSIONS if
# the model changes (default 1536 matches text-embedding-ada-002 / Gemini embedding-001).
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_API_KEY=replace-with-embedding-api-key
EMBEDDING_DIMENSIONS=1536
