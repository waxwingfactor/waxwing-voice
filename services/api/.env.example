# Waxwing API — environment variable reference
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env with real secrets to source control.
# Subbu manages real values in the secrets management system.

# ---------------------------------------------------------------------------
# Database
# Accepts postgresql:// or postgresql+asyncpg:// (env.py normalizes the prefix)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/waxwing

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=local
# 32+ random bytes — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-secret-key

# ---------------------------------------------------------------------------
# S3-compatible object storage (Phase 3 — document uploads and embeddings)
# For local dev: use MinIO (docker run -p 9000:9000 minio/minio)
# ---------------------------------------------------------------------------
S3_BUCKET=waxwing-documents
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# OpenAI (embeddings / RAG — Phase 3+)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=replace-with-openai-api-key

# ---------------------------------------------------------------------------
# SendGrid (Phase 4 — follow-up emails and tour confirmations)
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=SG.replace-with-api-key
SENDGRID_FROM_EMAIL=noreply@sunsetapts.example

# ---------------------------------------------------------------------------
# Google Calendar — service account (Phase 4 — tour availability and booking)
# Create a service account in GCP, share the target calendar with it, then
# download the JSON key file and set GOOGLE_SERVICE_ACCOUNT_PATH to its path.
# GOOGLE_CALENDAR_ID: use 'primary' or a dedicated calendar email address.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
GOOGLE_CALENDAR_ID=replace-with-calendar-id@group.calendar.google.com

# ---------------------------------------------------------------------------
# Embedding model (Phase 3 — RAG chunking and retrieval)
# Update EMBEDDING_DIMENSIONS if you switch models
# (default 1536 matches text-embedding-ada-002).
# ---------------------------------------------------------------------------
EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Twilio (inbound call webhooks and Twilio Media Streams bridge)
# TWILIO_ACCOUNT_SID: starts with "AC"
# TWILIO_AUTH_TOKEN: used to validate X-Twilio-Signature on inbound webhooks
# PUBLIC_BASE_URL: publicly reachable URL for this service (e.g. ngrok or Cloudflare Tunnel URL)
#   The bridge WebSocket is exposed at {PUBLIC_BASE_URL}/ws/twilio/media
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# ---------------------------------------------------------------------------
# LiveKit — bridge layer (services/api/app/bridge/)
# The bridge creates per-call rooms and joins them as the "twilio-bridge" participant.
# These are the SERVER-SIDE LiveKit keys (room management, access token minting).
# NOTE: The voice-agent service (services/voice-agent/) has its own LIVEKIT_* vars
#       in services/voice-agent/.env — they are the SAME project credentials but kept
#       in separate files because the services run in separate processes.
# LIVEKIT_URL: wss://your-project.livekit.cloud
# LIVEKIT_API_KEY: from LiveKit Cloud project settings
# LIVEKIT_API_SECRET: from LiveKit Cloud project settings — NEVER log this
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# Default scoping IDs — must match seed data UUIDs inserted by Alembic migrations.
DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001
DEFAULT_PROPERTY_ID=00000000-0000-0000-0000-000000000003
