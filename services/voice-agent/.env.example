# Voice Agent — environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
#
# Stack: Twilio + LiveKit + Whisper + Gemini-3.0 Flash + ElevenLabs Turbo v2.5
# Deployment: local + Cloudflare Tunnel for MVP demo (ADR-0003)
#
# For local dev without ElevenLabs credentials, set TTS_PROVIDER=mock.

# ---------------------------------------------------------------------------
# Backend connection (Harsha's FastAPI service)
# ---------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000

# HS256 JWT for backend auth. The voice agent only forwards this token in
# the Authorization header; it does NOT verify or sign JWTs locally, so
# SECRET_KEY lives only in the backend env.
#
# Mint offline via (run inside services/api/ with the backend's SECRET_KEY):
#   python -c "from app.auth import create_access_token; from datetime import timedelta; print(create_access_token({'company_id': '<uuid>'}, timedelta(days=365)))"
# Strategy for production minting: see BLOCKERS.md §7.
VOICE_AGENT_JWT=

# ---------------------------------------------------------------------------
# ElevenLabs (TTS) — ADR-0001, replaces VibeVoice
# Provisioned by Subbu. See docs/adr/0001-elevenlabs-replaces-vibevoice.md
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL  # Bella — phone-quality female voice (Turbo v2.5)

# Set to "mock" for local development without an ElevenLabs API key.
# Set to "elevenlabs" (default) for staging and production.
TTS_PROVIDER=elevenlabs

# ---------------------------------------------------------------------------
# Whisper (STT) — Phase 1 finish-up
# Hosted OpenAI Whisper. Subbu provisions the key. May share the same
# OpenAI key Harsha uses for embeddings; semantically distinct env var.
# ---------------------------------------------------------------------------
WHISPER_API_KEY=

# ---------------------------------------------------------------------------
# Gemini (LLM) — Phase 1 finish-up
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# LiveKit (voice orchestration)
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Twilio (telephony — inbound only for MVP)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Agent behavior
# ---------------------------------------------------------------------------
# Fallback property ID for local testing. In production this comes from
# Twilio call routing metadata (SIP headers or IVR).
DEFAULT_PROPERTY_ID=

SILENCE_TIMEOUT_SECONDS=3.0
MAX_RESPONSE_TOKENS=200
TOOL_RETRY_MAX_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json  # json (production) or console (local dev)
