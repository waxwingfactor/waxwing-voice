# Voice Agent — environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
#
# Stack: Twilio + LiveKit (ADR-0004) + Whisper + Gemini-2.0 Flash + ElevenLabs Turbo v2.5
# Deployment: local + Cloudflare Tunnel for MVP demo (ADR-0003)
#
# For offline/test mode (no API keys needed), set all three mock flags:
#   STT_PROVIDER=mock  LLM_PROVIDER=mock  TTS_PROVIDER=mock

# ---------------------------------------------------------------------------
# Backend connection (Harsha's FastAPI service)
# ---------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000

# HS256 JWT for backend auth. The voice agent only forwards this token in
# the Authorization header; it does NOT verify or sign JWTs locally, so
# SECRET_KEY lives only in the backend env.
#
# Mint offline via (run inside services/api/ with the backend's SECRET_KEY):
#   python -c "from app.auth import create_access_token; from datetime import timedelta; print(create_access_token({'company_id': '<uuid>'}, timedelta(days=365)))"
# Strategy for production minting: see BLOCKERS.md §7.
VOICE_AGENT_JWT=

# ---------------------------------------------------------------------------
# LiveKit (voice orchestration) — ADR-0004: Twilio→LiveKit bridge
# Provisioned by Subbu. Required for Phase 1 production.
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Whisper (STT) — Phase 1 finish-up
# Hosted OpenAI Whisper API. Provisioned by Subbu.
# Set STT_PROVIDER=mock for offline testing without a key.
# ---------------------------------------------------------------------------
WHISPER_API_KEY=

# STT provider selection.
#   whisper  — uses WhisperSTTAdapter (hosted OpenAI Whisper, requires WHISPER_API_KEY)
#   mock     — uses MockSTTAdapter (no network, for offline tests and CI)
STT_PROVIDER=whisper

# ---------------------------------------------------------------------------
# Gemini (LLM) — Phase 1 finish-up
# Direct REST to Gemini-2.0 Flash API (no google-generativeai SDK).
# Set LLM_PROVIDER=mock for offline testing without a key.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# LLM provider selection.
#   gemini  — uses GeminiLLMAdapter (Gemini-2.0 Flash, requires GEMINI_API_KEY)
#   mock    — uses MockLLMAdapter (no network, for offline tests and CI)
LLM_PROVIDER=gemini

# ---------------------------------------------------------------------------
# ElevenLabs (TTS) — ADR-0001, replaces VibeVoice
# Provisioned by Subbu. See docs/adr/0001-elevenlabs-replaces-vibevoice.md
# Set TTS_PROVIDER=mock for offline testing without a key.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL  # Bella — phone-quality female voice (Turbo v2.5)

# TTS provider selection.
#   elevenlabs  — uses ElevenLabsTTSAdapter (production, requires ELEVENLABS_API_KEY)
#   mock        — uses MockTTSAdapter (no network, for offline tests and CI)
TTS_PROVIDER=elevenlabs

# ---------------------------------------------------------------------------
# Twilio (telephony — inbound only for MVP)
# Harsha's backend owns the Twilio webhook. Voice-agent does NOT touch Twilio
# directly (ADR-0004: Twilio→LiveKit bridge). These vars are here for reference
# and for any future direct integration.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Agent behavior
# ---------------------------------------------------------------------------
# Fallback property ID for local testing. In production this comes from
# the LiveKit room metadata set by Harsha's backend (ADR-0004).
DEFAULT_PROPERTY_ID=

SILENCE_TIMEOUT_SECONDS=3.0
MAX_RESPONSE_TOKENS=200
TOOL_RETRY_MAX_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json  # json (production) or console (local dev)
