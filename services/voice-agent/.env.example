# Voice Agent — environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
#
# Stack: Twilio + LiveKit (ADR-0004) + Deepgram (ADR-0005) + Gemini 2.0 Flash + ElevenLabs Turbo v2.5
# Orchestration: LiveKit VoicePipelineAgent (ADR-0006)
# Deployment: local + Cloudflare Tunnel for MVP demo (ADR-0003)
#
# For offline/test mode (no API keys needed):
#   STT_PROVIDER=mock  LLM_PROVIDER=mock  TTS_PROVIDER=mock

# ---------------------------------------------------------------------------
# Backend connection (Harsha's FastAPI service)
# ---------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000
BACKEND_API_TIMEOUT_SECONDS=10.0

# HS256 JWT for backend auth. The voice agent only forwards this token in
# the Authorization header; it does NOT verify or sign JWTs locally.
#
# Mint offline via (run inside services/api/ with the backend's SECRET_KEY):
#   python -c "from app.auth import create_access_token; from datetime import timedelta; print(create_access_token({'company_id': '<uuid>'}, timedelta(days=365)))"
# Strategy for production minting: see BLOCKERS.md §7.
VOICE_AGENT_JWT=

# ---------------------------------------------------------------------------
# LiveKit (voice orchestration) — ADR-0004: Twilio→LiveKit bridge
# Provisioned by Subbu. Required for production.
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Deepgram (STT) — ADR-0005, replaces Whisper
# Streaming-first, ~150ms TTFT, nova-2-phonecall model (telephony-tuned).
# Free $200 credit covers ~775 hours of audio — sufficient for MVP demo.
# Provisioned by Subbu. Required when STT_PROVIDER=deepgram (default).
# See docs/adr/0005-deepgram-replaces-whisper.md
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=

# STT provider selection.
#   deepgram — uses livekit-plugins-deepgram nova-2-phonecall (PRODUCTION DEFAULT, ADR-0005)
#   whisper  — uses WhisperSTTAdapter for rollback (requires WHISPER_API_KEY)
#   mock     — uses MockSTTAdapter (no network, for offline tests and CI)
STT_PROVIDER=deepgram

# Whisper API key — only needed for rollback (STT_PROVIDER=whisper)
WHISPER_API_KEY=

# ---------------------------------------------------------------------------
# Gemini (LLM)
# Used via livekit-plugins-google (ADR-0006). Gemini Flash family locked.
# Set LLM_PROVIDER=mock for offline testing without a key.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# LLM provider selection.
#   gemini  — uses livekit-plugins-google Gemini Flash (requires GEMINI_API_KEY)
#   mock    — uses MockLLMAdapter (no network, for offline tests and CI)
LLM_PROVIDER=gemini

# ---------------------------------------------------------------------------
# ElevenLabs (TTS) — ADR-0001, replaces VibeVoice
# Used via livekit-plugins-elevenlabs (ADR-0006).
# Set TTS_PROVIDER=mock for offline testing without a key.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL  # Bella — phone-quality female voice (Turbo v2.5)

# TTS provider selection.
#   elevenlabs  — uses livekit-plugins-elevenlabs (production, requires ELEVENLABS_API_KEY)
#   mock        — uses MockTTSAdapter (no network, for offline tests and CI)
TTS_PROVIDER=elevenlabs

# ---------------------------------------------------------------------------
# Twilio (telephony — inbound only for MVP)
# Harsha's backend owns the Twilio webhook and bridge (ADR-0004).
# Voice-agent does NOT talk to Twilio directly. These vars are for reference
# and caller ID context that may be passed via LiveKit room metadata.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Agent behavior
# ---------------------------------------------------------------------------
# Fallback property ID for local testing. In production this comes from
# the LiveKit room metadata set by Harsha's bridge (ADR-0004).
DEFAULT_PROPERTY_ID=

SILENCE_TIMEOUT_SECONDS=8.0
MAX_RESPONSE_TOKENS=200
TOOL_RETRY_MAX_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json  # json (production) or console (local dev)
